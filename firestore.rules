rules_version = '2';

// 허니문닥터 Firestore 보안 규칙
//
// 설계 원칙 (스펙 9장):
// 1) 인증되지 않은 사용자는 전부 거부한다.
// 2) trips 컬렉션의 전체 목록 조회는 금지한다 — 클라이언트는 반드시
//    where("memberIds", "array-contains", uid) 쿼리로만 trips를 조회해야 하며,
//    이 규칙은 그 쿼리 형태와 무관하게 각 문서마다 memberIds 소속 여부를 검사한다.
// 3) 여행 구성원만 해당 여행과 모든 하위 컬렉션을 읽고 쓸 수 있다.
// 4) 참여 요청(joinRequests)은 초대코드 해시 일치 + 본인 UID 조건을 동시에 만족해야 생성되고,
//    승인 전 신청자는 여행 본문/하위 컬렉션을 절대 읽을 수 없다(멤버가 아니므로 자동으로 차단됨).
// 5) 소유자만 초대 승인/거절, 구성원 변경, 초대코드 변경, 여행 기본정보 변경을 수행하며,
//    getAfter()로 "구성원 2명 초과 금지"와 "소유자 유지"를 서버 측에서 강제한다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function tripDoc(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId));
    }

    function isTripMember(tripId) {
      return isSignedIn() &&
        request.auth.uid in tripDoc(tripId).data.memberIds;
    }

    function isTripOwner(tripId) {
      return isSignedIn() &&
        request.auth.uid == tripDoc(tripId).data.ownerId;
    }

    function isTripActive(tripId) {
      return tripDoc(tripId).data.get('status', 'ACTIVE') == 'ACTIVE';
    }

    // ── trips/{tripId} ─────────────────────────────────────────────
    match /trips/{tripId} {
      // get/list 모두 resource.data 기준으로 동일하게 검사한다. array-contains 필터가
      // 없는 무제한 목록 조회는 컬렉션 내 다른 여행 문서에 대해 이 조건이 깨지므로
      // Firestore가 요청 전체를 거부한다 — 이것이 "전체 여행 목록 조회 금지"의 근거다.
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;

      // 신규 여행 생성: 생성자 본인이 owner이자 유일한 최초 구성원이어야 한다.
      // 갓 생성된 여행은 공개 상태로 태어날 수 없다.
      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds.size() == 1 &&
        request.resource.data.memberIds[0] == request.auth.uid &&
        request.resource.data.get('isPublic', false) == false;

      // 여행 기본정보/구성원/초대코드/공개 여부 변경은 소유자만 가능하다.
      // getAfter()로 갱신 직후 상태까지 함께 검증해, 소유자 유지·최대 2인을 서버에서 강제한다.
      // 공개(isPublic=true)는 완료된 여행에서만, 그리고 초대코드 해시가 남아있지 않을 때만 켤 수
      // 있다 — 공개 사본을 본 사람이 그 해시로 참여 요청을 위조하지 못하게 하기 위함이다.
      function isOwnerRegularUpdate(tripId) {
        return isTripOwner(tripId) &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.memberIds.size() <= 2 &&
          request.resource.data.ownerId in request.resource.data.memberIds &&
          (request.resource.data.get('isPublic', false) == false ||
           (request.resource.data.get('status', 'ACTIVE') == 'COMPLETED' &&
            request.resource.data.get('inviteCodeHash', null) == null));
      }

      // 회원 탈퇴(일반 구성원): 본인 uid를 memberIds에서 제거하는 것 외에는 아무 것도 바꾸지
      // 않을 때만 허용한다 — 소유자가 아닌 사람이 다른 필드를 건드리거나 남을 제거하지 못하게.
      function isSelfLeave(tripId) {
        return isTripMember(tripId) &&
          request.auth.uid != resource.data.ownerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'updatedAt']) &&
          request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]);
      }

      // 회원 탈퇴(소유자, 동반자 있음): 유일한 남은 동반자에게 소유권을 넘기며 본인만 탈퇴한다.
      // "구성원이 정확히 2명일 때, 그 중 나를 빼고 남은 한 명이 새 소유자가 된다"로 범위를
      // 좁혀 일반적인 소유권 이전 백도어가 되지 않게 한다.
      function isOwnerLeaveWithTransfer(tripId) {
        return isTripOwner(tripId) &&
          resource.data.memberIds.size() == 2 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId', 'memberIds', 'updatedAt']) &&
          request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid]) &&
          request.resource.data.ownerId == request.resource.data.memberIds[0] &&
          request.resource.data.ownerId != resource.data.ownerId;
      }

      allow update: if isOwnerRegularUpdate(tripId) || isOwnerLeaveWithTransfer(tripId) || isSelfLeave(tripId);

      // 여행 삭제는 소유자만 가능하고, 공개 중인 여행은 먼저 공개를 내려야 삭제할 수 있다
      // (원본이 없어진 채로 공개 사본만 남는 상황을 막는다).
      allow delete: if isTripOwner(tripId) && resource.data.get('isPublic', false) == false;

      // ── trips/{tripId}/members/{uid} ────────────────────────────
      // 구성원 문서는 승인 트랜잭션의 일부로 소유자만 생성·수정한다.
      match /members/{memberUid} {
        allow read: if isTripMember(tripId);
        allow create, update: if isTripOwner(tripId);
        // 본인 탈퇴 시 자기 구성원 문서는 스스로 지울 수 있다(소유자는 여전히 아무 구성원이나 지울 수 있음).
        allow delete: if isTripOwner(tripId) || (isSignedIn() && request.auth.uid == memberUid);
      }

      // ── trips/{tripId}/joinRequests/{requestId} ─────────────────
      match /joinRequests/{requestId} {
        // 본인이 신청한 요청은 본인이, 소유자는 모든 요청을 읽을 수 있다.
        allow get: if isSignedIn() &&
          (request.auth.uid == resource.data.applicantUid || isTripOwner(tripId));
        allow list: if isTripOwner(tripId);

        // 참여 요청 생성: 본인 UID + 초대코드 해시 일치를 동시에 만족해야 한다. 문서 ID도
        // 본인 UID로 고정해, 신청자가 auto-ID를 몰라도 나중에 자기 요청 상태(거절 등)를
        // 직접 조회할 수 있게 한다(위 allow get이 그 문서 하나는 본인에게 허용).
        // 승인 전 신청자는 아직 memberIds에 없으므로 위 isTripMember() 조건에 의해
        // 여행 본문/하위 컬렉션을 읽을 수 없다.
        allow create: if isSignedIn() &&
          requestId == request.auth.uid &&
          request.resource.data.applicantUid == request.auth.uid &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.inviteCodeHash == tripDoc(tripId).data.inviteCodeHash;

        // 승인/거절 처리는 소유자만 한다.
        allow update, delete: if isTripOwner(tripId);
      }

      // ── 여행 구성원이라면 CRUD 가능한 운영 데이터 컬렉션 ─────────
      // (일정, 예약, 준비물, 경비, 예산, 장소, 결정함, 도시)
      // 완료된 여행(status != ACTIVE)은 구성원도 더 이상 쓸 수 없다 — 읽기는 계속 허용해
      // 완료 후에도 내용을 볼 수 있게 한다.
      match /{collection}/{docId} {
        allow read: if isTripMember(tripId) && collection in [
          'cities', 'itinerary', 'reservations', 'checklistItems',
          'expenses', 'budgets', 'places', 'decisions'
        ];
        allow write: if isTripMember(tripId) && isTripActive(tripId) && collection in [
          'cities', 'itinerary', 'reservations', 'checklistItems',
          'expenses', 'budgets', 'places', 'decisions'
        ];
      }
    }

    // ── publicTrips/{tripId} ───────────────────────────────────────
    // 완료 후 소유자가 명시적으로 "공개"한 여행의 사본. 원본(trips/*)은 계속 구성원만
    // 읽을 수 있다 — trips 문서를 그대로 공개하면 inviteCodeHash가 노출돼 아무나 참여
    // 요청을 위조할 수 있게 되기 때문이다. Firestore 규칙은 필드 단위 필터가 불가능하므로,
    // 공개 범위(이름·기간·도시·일정의 "경로"만, 메모·예상경비·예약·경비·준비물·결정함 제외)는
    // 여기서가 아니라 발행 시점의 Kotlin 매핑(허용 목록)으로 고정한다.
    match /publicTrips/{tripId} {
      function isSourceTripOwner() {
        return isSignedIn() &&
          request.auth.uid == get(/databases/$(database)/documents/trips/$(tripId)).data.ownerId;
      }

      allow read: if isSignedIn();
      allow create, update, delete: if isSourceTripOwner();

      match /cities/{cityId} {
        allow read: if isSignedIn();
        allow write: if isSourceTripOwner();
      }
      match /itinerary/{itemId} {
        allow read: if isSignedIn();
        allow write: if isSourceTripOwner();
      }
    }
  }
}
